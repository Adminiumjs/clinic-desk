{
  "manifestVersion": 1,
  "key": "clinic",
  "name": "Clinic Desk",
  "version": "1.0.0",
  "publisher": {
    "id": "adminium",
    "name": "Adminium",
    "url": "https://adminium.dev"
  },
  "license": "AGPL-3.0-only",
  "description": {
    "key": "mft.clinic.desc",
    "fallback": "An appointment desk for a small practice: who is coming and when, checking them in, what they owe and who is due back — backed by your own database."
  },
  "categories": [
    "operations"
  ],
  "compatibility": {
    "minAdminiumVersion": "1.0.0",
    "engines": [
      "postgres",
      "mysql",
      "sqlite"
    ],
    "requires": [
      "realtime"
    ]
  },
  "requiredSchema": {
    "tables": [
      {
        "ref": "clinicians",
        "columns": [
          {
            "ref": "id",
            "type": "int",
            "role": "pk"
          },
          {
            "ref": "name",
            "type": "text"
          },
          {
            "ref": "initials",
            "type": "text"
          },
          {
            "ref": "avatar",
            "type": "text",
            "semantic": "image"
          },
          {
            "ref": "role",
            "type": "enum",
            "enum": [
              "gp",
              "physiotherapist",
              "nurse"
            ]
          },
          {
            "ref": "color",
            "type": "text"
          },
          {
            "ref": "active",
            "type": "bool"
          }
        ]
      },
      {
        "ref": "clinician_hours",
        "columns": [
          {
            "ref": "id",
            "type": "int",
            "role": "pk"
          },
          {
            "ref": "clinician_id",
            "type": "fk",
            "references": "clinicians"
          },
          {
            "ref": "weekday",
            "type": "enum",
            "enum": [
              "mon",
              "tue",
              "wed",
              "thu",
              "fri",
              "sat",
              "sun"
            ]
          },
          {
            "ref": "opens",
            "type": "text"
          },
          {
            "ref": "closes",
            "type": "text"
          },
          {
            "ref": "break_start",
            "type": "text"
          },
          {
            "ref": "break_end",
            "type": "text"
          }
        ]
      },
      {
        "ref": "visit_types",
        "columns": [
          {
            "ref": "id",
            "type": "int",
            "role": "pk"
          },
          {
            "ref": "name",
            "type": "text"
          },
          {
            "ref": "minutes",
            "type": "int"
          },
          {
            "ref": "fee",
            "type": "money"
          },
          {
            "ref": "color",
            "type": "text"
          }
        ]
      },
      {
        "ref": "patients",
        "columns": [
          {
            "ref": "id",
            "type": "int",
            "role": "pk"
          },
          {
            "ref": "name",
            "type": "text"
          },
          {
            "ref": "initials",
            "type": "text"
          },
          {
            "ref": "born_on",
            "type": "date"
          },
          {
            "ref": "phone",
            "type": "text"
          },
          {
            "ref": "email",
            "type": "text",
            "semantic": "email"
          },
          {
            "ref": "allergies_note",
            "type": "text"
          },
          {
            "ref": "insurer",
            "type": "text"
          },
          {
            "ref": "policy_ref",
            "type": "text"
          },
          {
            "ref": "created_at",
            "type": "timestamptz"
          }
        ]
      },
      {
        "ref": "appointments",
        "columns": [
          {
            "ref": "id",
            "type": "int",
            "role": "pk"
          },
          {
            "ref": "ref",
            "type": "text"
          },
          {
            "ref": "patient_id",
            "type": "fk",
            "references": "patients"
          },
          {
            "ref": "clinician_id",
            "type": "fk",
            "references": "clinicians"
          },
          {
            "ref": "visit_type_id",
            "type": "fk",
            "references": "visit_types"
          },
          {
            "ref": "starts_at",
            "type": "timestamptz"
          },
          {
            "ref": "minutes",
            "type": "int"
          },
          {
            "ref": "reason",
            "type": "text"
          },
          {
            "ref": "desk_note",
            "type": "text"
          },
          {
            "ref": "status",
            "type": "enum",
            "enum": [
              "booked",
              "checked_in",
              "roomed",
              "with_clinician",
              "ready",
              "done",
              "no_show",
              "cancelled"
            ]
          },
          {
            "ref": "checked_in_at",
            "type": "timestamptz"
          },
          {
            "ref": "cancelled_at",
            "type": "timestamptz"
          },
          {
            "ref": "late_cancel",
            "type": "bool"
          },
          {
            "ref": "created_at",
            "type": "timestamptz"
          }
        ]
      },
      {
        "ref": "recalls",
        "columns": [
          {
            "ref": "id",
            "type": "int",
            "role": "pk"
          },
          {
            "ref": "patient_id",
            "type": "fk",
            "references": "patients"
          },
          {
            "ref": "from_appointment_id",
            "type": "fk",
            "references": "appointments"
          },
          {
            "ref": "due_on",
            "type": "date"
          },
          {
            "ref": "reason",
            "type": "text"
          },
          {
            "ref": "booked",
            "type": "bool"
          }
        ]
      },
      {
        "ref": "charges",
        "columns": [
          {
            "ref": "id",
            "type": "int",
            "role": "pk"
          },
          {
            "ref": "appointment_id",
            "type": "fk",
            "references": "appointments"
          },
          {
            "ref": "amount",
            "type": "money"
          },
          {
            "ref": "created_at",
            "type": "timestamptz"
          }
        ]
      },
      {
        "ref": "payments",
        "columns": [
          {
            "ref": "id",
            "type": "int",
            "role": "pk"
          },
          {
            "ref": "charge_id",
            "type": "fk",
            "references": "charges"
          },
          {
            "ref": "amount",
            "type": "money"
          },
          {
            "ref": "method",
            "type": "enum",
            "enum": [
              "card",
              "cash",
              "transfer"
            ]
          },
          {
            "ref": "paid_at",
            "type": "timestamptz"
          }
        ]
      },
      {
        "ref": "closures",
        "columns": [
          {
            "ref": "id",
            "type": "int",
            "role": "pk"
          },
          {
            "ref": "clinician_id",
            "type": "fk",
            "references": "clinicians"
          },
          {
            "ref": "on_date",
            "type": "date"
          },
          {
            "ref": "reason",
            "type": "text"
          }
        ]
      }
    ]
  },
  "pages": [
    {
      "ref": "clinic-dashboard",
      "template": "page-dashboard",
      "title": {
        "key": "mft.clinic.page.dashboard",
        "fallback": "Dashboard"
      },
      "nav": {
        "group": "manifest:clinic",
        "icon": "layout-dashboard",
        "order": 1
      }
    },
    {
      "ref": "clinic-day",
      "template": "page-calendar",
      "title": {
        "key": "mft.clinic.page.day",
        "fallback": "Day sheet"
      },
      "nav": {
        "group": "manifest:clinic",
        "icon": "calendar-days",
        "order": 2
      }
    },
    {
      "ref": "clinic-patients",
      "template": "page-crud",
      "title": {
        "key": "mft.clinic.page.patients",
        "fallback": "Patients"
      },
      "nav": {
        "group": "manifest:clinic",
        "icon": "users",
        "order": 3
      }
    },
    {
      "ref": "clinic-queue",
      "template": "page-queue-inbox",
      "title": {
        "key": "mft.clinic.page.queue",
        "fallback": "Waiting room"
      },
      "nav": {
        "group": "manifest:clinic",
        "icon": "armchair",
        "order": 4
      }
    },
    {
      "ref": "clinic-accounts",
      "template": "page-crud",
      "title": {
        "key": "mft.clinic.page.accounts",
        "fallback": "Accounts"
      },
      "nav": {
        "group": "manifest:clinic",
        "icon": "receipt",
        "order": 5
      }
    },
    {
      "ref": "clinic-recalls",
      "template": "page-queue-inbox",
      "title": {
        "key": "mft.clinic.page.recalls",
        "fallback": "Recalls"
      },
      "nav": {
        "group": "manifest:clinic",
        "icon": "calendar-clock",
        "order": 6
      }
    }
  ],
  "capabilities": [
    "payments",
    "email-delivery",
    "realtime"
  ],
  "kind": "app",
  "frontends": [
    {
      "side": "staff",
      "kind": "spa",
      "entry": "index.html",
      "env": {
        "VITE_ADMINIUM_API_BASE_URL": {
          "required": false,
          "example": "https://admin.example.com"
        },
        "VITE_ADMINIUM_PUBLISHABLE_KEY": {
          "required": false,
          "example": "adm_pub_..."
        }
      },
      "routes": {
        "desk": "/"
      }
    },
    {
      "side": "customer",
      "kind": "spa",
      "entry": "index.html",
      "env": {
        "VITE_ADMINIUM_API_BASE_URL": {
          "required": false,
          "example": "https://admin.example.com"
        },
        "VITE_ADMINIUM_PUBLISHABLE_KEY": {
          "required": false,
          "example": "adm_pub_..."
        }
      },
      "routes": {
        "book": "/",
        "visits": "/"
      }
    }
  ]
}
